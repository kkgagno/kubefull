<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>OpenSCAP Node Scan Index</title>
<style>
  :root { --bg:#1a1a2e; --card:#16213e; --text:#e0e0e0; --accent:#0f3460; --blue:#3498db; }
  body { font-family: system-ui, -apple-system, sans-serif; background: var(--bg); color: var(--text);
         margin: 0; padding: 2rem; max-width: 80rem; margin: 0 auto; }
  h1 { color: #fff; border-bottom: 2px solid var(--accent); padding-bottom: 0.5rem; }
  table { width: 100%; border-collapse: collapse; margin: 1rem 0; background: var(--card);
          border-radius: 8px; overflow: hidden; }
  th, td { padding: 0.75rem 1rem; text-align: left; border-bottom: 1px solid var(--accent); }
  th { background: var(--accent); color: #fff; font-weight: 600; }
  a { color: var(--blue); text-decoration: none; }
  a:hover { text-decoration: underline; }
  tr:hover { background: rgba(255,255,255,0.03); }
  .header-info { color: #aaa; font-size: 0.9rem; margin-bottom: 1.5rem; }
</style>
</head>
<body>
  <h1>OpenSCAP Node Scan Reports</h1>
  <div class="header-info">Compliance + vulnerability scans per Kubernetes node. Generated: {{ now() }}</div>

  <table>
    <thead>
      <tr><th>Hostname</th><th>Summary</th><th>Compliance Report</th><th>Vulnerability Report</th></tr>
    </thead>
    <tbody>
      {% set scanned = host_reports | default({}) %}
      {% for host in groups['k8s_cluster'] | default([]) | sort %}
      <tr>
        <td><strong>{{ host }}</strong></td>
        {% if host in scanned %}
        <td><a href="openscap-summaries/{{ host }}.html">View Summary</a></td>
        <td><a href="nodes/{{ host }}/compliance-report.html">Compliance (raw)</a></td>
        <td><a href="nodes/{{ host }}/vulnerability-report.html">Vulnerability (raw)</a></td>
        {% else %}
        <td><span style="color:#666;">Not scanned yet</span></td>
        <td><span style="color:#666;">Not scanned yet</span></td>
        <td><span style="color:#666;">Not scanned yet</span></td>
        {% endif %}
      </tr>
      {% endfor %}
    </tbody>
  </table>
</body>
</html>
